{
  "name": "aiomatrix",
  "version": "0.5.0",
  "description": "Aiogram-like framework for Matrix bots: routers, filters, FSM, inline keyboards, E2EE and MiniApps",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.js"
    },
    "./miniapp": {
      "types": "./dist/miniapp/index.d.ts",
      "import": "./dist/miniapp/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "MINIAPP.md",
    "CHANGELOG.md",
    "AUDIT.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test",
    "test:only": "node --test",
    "test:live": "node --test test/live",
    "test:live:ci": "node scripts/live-hs.mjs",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "dev": "tsx examples/echo/src/main.ts",
    "prepublishOnly": "npm run clean && npm run build && npm run test:only"
  },
  "keywords": [
    "matrix",
    "matrix-bot",
    "bot",
    "bot-framework",
    "e2ee",
    "olm",
    "megolm",
    "aiogram",
    "miniapp",
    "webapp",
    "widget",
    "fsm",
    "aiomatrix"
  ],
  "author": "Howard Salibert / StudNovSU contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HowardSalibert/aiomatrix.git"
  },
  "bugs": {
    "url": "https://github.com/HowardSalibert/aiomatrix/issues"
  },
  "homepage": "https://github.com/HowardSalibert/aiomatrix#readme",
  "optionalDependencies": {
    "@matrix-org/matrix-sdk-crypto-nodejs": "^0.4.0"
  },
  "devDependencies": {
    "@matrix-org/matrix-sdk-crypto-nodejs": "^0.4.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
