{
  "name": "aiomatrix",
  "version": "0.8.0",
  "description": "Aiogram-like framework for Matrix bots: routers, filters, FSM, inline keyboards, E2EE and MiniApps",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aiomatrix": "./dist/cli/main.js"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.js"
    },
    "./miniapp": {
      "types": "./dist/miniapp/index.d.ts",
      "import": "./dist/miniapp/index.js"
    },
    "./redis": {
      "types": "./dist/redis-stores.d.ts",
      "import": "./dist/redis-stores.js"
    },
    "./otel": {
      "types": "./dist/otel.d.ts",
      "import": "./dist/otel.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "MINIAPP.md",
    "AWARE_HOST.md",
    "SCENES.md",
    "COMPAT.md",
    "PUBLIC_API.md",
    "CHANGELOG.md",
    "AUDIT.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"test/**/*.mjs\"",
    "test:only": "node --test \"test/**/*.mjs\"",
    "test:live": "node --test \"test/live/**/*.mjs\"",
    "test:live:ci": "node scripts/live-hs.mjs",
    "test:appservice": "npm --prefix packages/appservice install && npm --prefix packages/appservice test",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "doctor": "node dist/cli/main.js doctor",
    "check:api": "node scripts/check-public-api.mjs",
    "check:size": "node scripts/check-bundle-size.mjs",
    "dev": "tsx examples/echo/src/main.ts",
    "prepublishOnly": "npm run clean && npm run build && npm run test:only && npm run check:api && npm run check:size"
  },
  "keywords": [
    "matrix",
    "matrix-bot",
    "bot",
    "bot-framework",
    "e2ee",
    "olm",
    "megolm",
    "aiogram",
    "miniapp",
    "webapp",
    "widget",
    "fsm",
    "aiomatrix",
    "appservice"
  ],
  "author": "Howard Salibert / StudNovSU contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HowardSalibert/aiomatrix.git"
  },
  "bugs": {
    "url": "https://github.com/HowardSalibert/aiomatrix/issues"
  },
  "homepage": "https://github.com/HowardSalibert/aiomatrix#readme",
  "optionalDependencies": {
    "@matrix-org/matrix-sdk-crypto-nodejs": "^0.6.1"
  },
  "peerDependencies": {
    "redis": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@matrix-org/matrix-sdk-crypto-nodejs": "^0.6.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
