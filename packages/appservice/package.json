{
  "name": "@aiomatrix/appservice",
  "version": "0.1.0",
  "private": true,
  "description": "Universal Matrix Application Service for aiomatrix bots (any homeserver with AS API)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aiomatrix-appservice": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/**/*.test.mjs",
    "test:only": "node --test test/**/*.test.mjs"
  },
  "keywords": [
    "matrix",
    "appservice",
    "aiomatrix"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
