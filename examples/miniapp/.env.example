MATRIX_HS_URL=https://matrix.example.org
MATRIX_USER_ID=@mybot:example.org
MATRIX_PASSWORD=

# Where the mini app is reachable from the user's browser. For a local trial,
# http://localhost:8080 is accepted; anything remote must be https.
MINIAPP_PUBLIC_URL=http://localhost:8080
PORT=8080

# Shared between this bot and the mini app backend. Leave empty to have the bot
# generate one into ./data/miniapp.json on first run.
MINIAPP_SECRET=

MATRIX_CRYPTO=true
LOG_LEVEL=info
