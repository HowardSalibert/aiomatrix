# A full URL, a bare server name (example.org), or the bot's user id (@bot:example.org).
MATRIX_HS_URL=https://matrix.example.org

# Preferred: password login. Persists the session and device id under ./data,
# which is what end-to-end encryption needs across restarts.
MATRIX_USER_ID=@mybot:example.org
MATRIX_PASSWORD=

# Alternative: an existing access token. Then MATRIX_DEVICE_ID must match the
# device that token belongs to, or crypto will refuse to start.
# MATRIX_ACCESS_TOKEN=syt_xxxxxxxx
# MATRIX_DEVICE_ID=BOTDEVICE

# Encrypts the crypto store at rest.
MATRIX_CRYPTO_PASSPHRASE=

# Set to false to run without E2EE (no native bindings needed).
MATRIX_CRYPTO=true

LOG_LEVEL=info
